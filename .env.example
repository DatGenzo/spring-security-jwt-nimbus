SERVER_PORT=8091

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=jwt_nimbus;encrypt=false;trustServerCertificate=true;characterEncoding=UTF-8
DB_USERNAME=sa
DB_PASSWORD=YOUR_DATABASE_PASSWORD

JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ISSUER=spring-security-jwt-nimbus
JWT_EXPIRATION_TIME=3600000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=123456
ADMIN_FULL_NAME=\u0110\u1ed7 Th\u00e0nh \u0110\u1ea1t
